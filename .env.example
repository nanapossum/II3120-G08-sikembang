# mock = data palsu lewat MSW (tanpa backend). live = panggil backend sungguhan.
VITE_API_MODE=mock
# Basis URL REST API (mode live). Contoh: /api (dengan proxy dev) atau https://api.contoh.id/api
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
# Hanya dev: target proxy untuk /api agar tidak perlu CORS
VITE_DEV_PROXY_TARGET=
